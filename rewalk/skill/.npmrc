# Real directories, not a symlink farm.
#
# This directory SHIPS. A skill is copied to another machine whole, which is why
# node_modules lives inside it rather than beside it, and pnpm's default layout
# would make every package a relative symlink into node_modules/.pnpm. Those
# survive a faithful copy and nothing else — a `cp -L`, a zip that flattens
# links, an rsync without -a, and the engine arrives as dangling pointers.
# Hoisted costs disk that a shipped tree was going to spend anyway.
node-linker=hoisted
