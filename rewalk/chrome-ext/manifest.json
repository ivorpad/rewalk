{
  "manifest_version": 3,
  "name": "rewalk recorder",
  "version": "0.1.0",
  "description": "Record the page you are on — DOM, voice, and alt-click pointing — into a rewalk session in your real Chrome profile.",
  "key": "",
  "permissions": ["scripting", "nativeMessaging"],
  "host_permissions": ["<all_urls>"],
  "background": { "service_worker": "src/sw.js" },
  "content_scripts": [
    {
      "matches": ["<all_urls>"],
      "js": ["src/boot.main.js"],
      "run_at": "document_start",
      "world": "MAIN",
      "all_frames": false
    },
    {
      "matches": ["<all_urls>"],
      "js": ["src/relay.iso.js"],
      "run_at": "document_start",
      "world": "ISOLATED",
      "all_frames": false
    }
  ]
}
